{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "sourceMap": true,
    "target": "ES2020",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "lib": ["ES2020", "ES2015.Promise"],
    "ignoreDeprecations": "5.0"
  },
  "compileOnSave": true,
  "include": ["src"]
}
