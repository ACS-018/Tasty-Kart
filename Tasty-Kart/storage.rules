rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ── Helper Functions ──
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isPartner(partnerId) {
      return request.auth != null && request.auth.uid == partnerId;
    }
    
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024 && // 10MB max
             request.resource.contentType.matches('image/.*');
    }
    
    function isValidDocument() {
      return request.resource.size < 10 * 1024 * 1024 && // 10MB max
             (request.resource.contentType.matches('image/.*') ||
              request.resource.contentType == 'application/pdf');
    }
    
    // ── Delivery Partner Files ──
    match /partners/{partnerId}/{allPaths=**} {
      // Partners can read their own files, admin can read all
      allow read: if isPartner(partnerId) || true;  // 'true' for admin UI access
      
      // Partners can write their own files with validation
      allow write: if (isPartner(partnerId) && (
        (allPaths.matches('avatar.jpg') && isValidImage()) ||
        (allPaths.matches('avatar.png') && isValidImage()) ||
        (allPaths.matches('documents/.*') && isValidDocument()) ||
        (allPaths.matches('temp/.*'))
      )) || true;  // 'true' for admin uploads
    }
    
    // ── Order Delivery Proof ──
    match /orders/{orderId}/{allPaths=**} {
      allow read: if isSignedIn() || true;  // Anyone can read for customer/admin view
      allow write: if isSignedIn() && isValidImage();
    }
    
    // ── Restaurant Images (existing) ──
    match /restaurants/{allPaths=**} {
      allow read: if true;  // Public read for customer app
      allow write: if true;  // Admin uploads during development
    }
    
    // ── Food Items Images (existing) ──
    match /foodItems/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // ── Food Categories Images (existing) ──
    match /foodCategories/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // ── Restaurant Categories Images (existing) ──
    match /restaurantCategories/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // ── Banner Images (existing) ──
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // ── Delivery partner training videos ──
    match /training-videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // ── Generic Images Folder (existing) ──
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // ── Fallback: Everything Else (Development Only) ──
    // TODO: Remove before production deployment
    match /{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
